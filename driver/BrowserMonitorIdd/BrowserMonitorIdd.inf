;
; BrowserMonitorIdd.inf
; Derived from microsoft/Windows-driver-samples video/IndirectDisplay/IddSampleDriver/IddSampleDriver.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=BrowserMonitorIdd.cat
DriverVer= ; set by stampinf during the build

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=MyDevice_Install, Root\BrowserMonitorIdd ; root-enumerated device (devcon, Visual Studio remote debugging)
%DeviceName%=MyDevice_Install, BrowserMonitorIdd      ; software device created by BrowserMonitorIddApp.exe

[SourceDisksFiles]
BrowserMonitorIdd.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "BrowserMonitorIddGroup" ; dedicated WUDFHost process

[MyDevice_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[MyDevice_Install.NT.Wdf]
UmdfService=BrowserMonitorIdd,BrowserMonitorIdd_Install
UmdfServiceOrder=BrowserMonitorIdd
UmdfKernelModeClientPolicy = AllowKernelModeClients

[BrowserMonitorIdd_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\BrowserMonitorIdd.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
BrowserMonitorIdd.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="Browser Monitor"
DiskName = "Browser Monitor Virtual Display Installation Disk"
DeviceName="Browser Monitor Virtual Display"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
