;
; LaptopMonitorIdd.inf
; Derived from microsoft/Windows-driver-samples video/IndirectDisplay/IddSampleDriver/IddSampleDriver.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=LaptopMonitorIdd.cat
DriverVer= ; set by stampinf during the build

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...22000

[Standard.NT$ARCH$.10.0...22000]
%DeviceName%=MyDevice_Install, Root\LaptopMonitorIdd ; root-enumerated device (devcon, Visual Studio remote debugging)
%DeviceName%=MyDevice_Install, LaptopMonitorIdd      ; software device created by LaptopMonitorIddApp.exe

[SourceDisksFiles]
LaptopMonitorIdd.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "LaptopMonitorIddGroup" ; dedicated WUDFHost process

[MyDevice_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[MyDevice_Install.NT.Wdf]
UmdfService=LaptopMonitorIdd,LaptopMonitorIdd_Install
UmdfServiceOrder=LaptopMonitorIdd
UmdfKernelModeClientPolicy = AllowKernelModeClients

[LaptopMonitorIdd_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\LaptopMonitorIdd.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
LaptopMonitorIdd.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="Laptop Monitor"
DiskName = "Laptop Monitor Virtual Display Installation Disk"
DeviceName="Laptop Monitor Virtual Display"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
