<Project>
  <!-- WDK/SDK come from NuGet (restored by scripts/build-driver.ps1), mirroring Windows-driver-samples' Directory.Build.props.
       When the packages are absent MSBuild falls back to an installed WDK. -->
  <PropertyGroup>
    <WdkPackages>$(MSBuildThisFileDirectory)..\.deps\packages\</WdkPackages>
  </PropertyGroup>
  <Import Project="$(WdkPackages)Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props" Condition="Exists('$(WdkPackages)Microsoft.Windows.WDK.x64.10.0.28000.2526\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'"/>
  <Import Project="$(WdkPackages)Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props" Condition="Exists('$(WdkPackages)Microsoft.Windows.SDK.CPP.x64.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'"/>
  <Import Project="$(WdkPackages)Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props" Condition="Exists('$(WdkPackages)Microsoft.Windows.SDK.CPP.10.0.28000.2526\build\native\Microsoft.Windows.SDK.cpp.props')"/>
</Project>
