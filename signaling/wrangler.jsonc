{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "browser-monitor-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "durable_objects": {
    "bindings": [
      {"name": "ROOMS", "class_name": "Room"},
      {"name": "CODES", "class_name": "Code"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["Room"]},
    {"tag": "v2", "new_sqlite_classes": ["Code"]}
  ],
  // Pairing attempts per client IP. Wrong codes never reach a room, so this is the brute-force ceiling.
  "ratelimits": [{"name": "PAIR_LIMIT", "namespace_id": "1001", "simple": {"limit": 12, "period": 60}}],
  "vars": {"ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://danielw412.github.io"},
  "observability": {"enabled": false}
}
